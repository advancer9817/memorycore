#!/usr/bin/env bash
# mcore — MemoryCore service manager
# Delegates start/stop/restart/status to systemd; passes everything else to the Python CLI.
#
# Usage:
#   mcore start|stop|restart [all|server|ui]   — manage services (default: all)
#   mcore status                                — show status of all services
#   mcore <subcommand> [args...]                — Python CLI passthrough

PYTHON="${MCORE_PYTHON:-__PYTHON__}"
TARGET="${2:-all}"

svc_op() {
  local op="$1"
  case "$TARGET" in
    all)    systemctl --user "$op" mcore.service mcore-ui.service ;;
    ui)     systemctl --user "$op" mcore-ui.service ;;
    server) systemctl --user "$op" mcore.service ;;
    *)      echo "Unknown target: $TARGET (use: all, ui, server)" >&2; exit 1 ;;
  esac
}

case "${1:-}" in
  start)   svc_op start ;;
  stop)    svc_op stop ;;
  restart) svc_op restart ;;
  status)  systemctl --user status mcore.service mcore-ui.service --no-pager ;;
  "")      echo "Usage: mcore {start|stop|restart|status} [all|server|ui]" >&2; exit 2 ;;
  *)       exec "$PYTHON" -m memorycore "$@" ;;
esac

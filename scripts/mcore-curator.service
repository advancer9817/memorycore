[Unit]
Description=MemoryCore curator run
After=network-online.target __MCORE_SERVICE__
Wants=network-online.target __MCORE_SERVICE__

[Service]
Type=oneshot
WorkingDirectory=__ROOT__
EnvironmentFile=-__ENV_FILE__
Environment=PYTHONPATH=__ROOT__
Environment=LOCAL_MEMORY_CONFIG=__CONFIG__
Environment=LOCAL_MEMORY_DB=__DB__
Environment=LOCAL_MEMORY_CURATOR_APPLY=__CURATOR_APPLY__
Environment=LOCAL_MEMORY_CURATOR_LIMIT=__CURATOR_LIMIT__
Environment=LOCAL_MEMORY_STALE_AFTER_DAYS=__STALE_AFTER_DAYS__
Environment=LOCAL_MEMORY_ARCHIVE_AFTER_DAYS=__ARCHIVE_AFTER_DAYS__
ExecStart=__ROOT__/run_curator.sh
StandardOutput=append:__ROOT__/logs/curator.log
StandardError=append:__ROOT__/logs/curator.log

#!/usr/bin/env bash
# git pre-push hook — 备份到 Google Drive + 提示 memory-sync 用 git syncpush
#
# 注意：memory-sync 的「导出+commit」已移到 git syncpush（scripts/hooks/git-push.sh）。
# 原因（2026-08-24 实测）：git 在运行 pre-push hook 前已锁定要发送的对象集合，
# hook 内新 commit 无法被当次 push 携带（外层 push 用 hook 前捕获的 SHA），
# 会产生遗留 commit 需要二次推送。前置 commit（wrapper）才能一次 push 全带上。
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
MCORE_DIR="${MCORE_DIR:-$HOME/project/memorycore}"
SYNC_FILE="memory-sync/memories.json"

[[ "$REPO_ROOT" == "$MCORE_DIR" ]] || exit 0

# ── 1. 提示：memory-sync 有未提交变更时提醒用 git syncpush ──────────────
if cd "$MCORE_DIR" 2>/dev/null; then
  if ! git diff --quiet "$SYNC_FILE" 2>/dev/null || ! git ls-files --error-unmatch "$SYNC_FILE" &>/dev/null; then
    echo "[pre-push] NOTE: memory-sync 有未提交变更，本次 push 不会携带记忆导出。" >&2
    echo "[pre-push]       请使用: git syncpush origin main（先导出记忆再推送，一次完成）" >&2
  fi
fi

# ── 2. 全量备份到 Google Drive（后台执行）────────────────────────────────
GDRIVE_BACKUP="$MCORE_DIR/scripts/gdrive-backup.sh"
if [[ -x "$GDRIVE_BACKUP" ]]; then
  echo "[pre-push] Starting Google Drive full backup (background)..." >&2
  mkdir -p "$MCORE_DIR/logs"
  nohup "$GDRIVE_BACKUP" >> "$MCORE_DIR/logs/gdrive-backup.log" 2>&1 &
fi

exit 0
[Unit]
Description=MemoryCore Web UI (HTTP :__UI_PORT__)
After=mcore.service
Wants=mcore.service

[Service]
Type=simple
WorkingDirectory=__ROOT__/ui
ExecStart=__NODE__ __ROOT__/ui/node_modules/next/dist/bin/next dev --port __UI_PORT__
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

# MemoryCore Environment Variables
# Copy this file to .env and adjust values as needed.

# ── Core ──────────────────────────────────────────────────────────────────────
# LOCAL_MEMORY_ROOT=/path/to/memorycore       # Project root (default: cwd)
# LOCAL_MEMORY_DB=/path/to/memory.sqlite3     # Database path (default: $ROOT/memory.sqlite3)
# LOCAL_MEMORY_CONFIG=/path/to/config.yaml    # Config path (default: $ROOT/config.yaml)

# ── HTTP Server ───────────────────────────────────────────────────────────────
# MCORE_HOST=127.0.0.1                        # Bind address (default: 127.0.0.1)
# MCORE_PORT=8318                             # Port (default: 8318)
# LOCAL_MEMORY_FRONTEND_TOKEN=                # Bearer token for remote access (required if non-loopback)

# ── Embedding ─────────────────────────────────────────────────────────────────
# LOCAL_MEMORY_EMBEDDING_PROVIDER=auto        # auto | ollama | openai | api | hashing
# LOCAL_MEMORY_EMBEDDING_API_URL=             # OpenAI-compatible embedding API URL
# LOCAL_MEMORY_EMBEDDING_API_KEY=             # API key for embedding service
# LOCAL_MEMORY_EMBEDDING_MODEL=               # Model name (default: nomic-embed-text)

# ── Extraction (LLM) ─────────────────────────────────────────────────────────
# LOCAL_MEMORY_LLM_BASE_URL=                  # OpenAI-compatible LLM API URL
# LOCAL_MEMORY_LLM_API_KEY=                   # API key for extraction LLM
# LOCAL_MEMORY_LLM_MODEL=                     # Model name (default: deepseek-chat)

# ── Qdrant ────────────────────────────────────────────────────────────────────
# QDRANT_URL=http://localhost:6333            # Qdrant server URL
# QDRANT_API_KEY=                             # Qdrant API key (if auth enabled)

# ── Sync ──────────────────────────────────────────────────────────────────────
# MCORE_AUTO_SYNC=1                           # Auto git sync on start/stop (0 to disable)
# SYNC_REMOTE=origin                          # Git remote for sync
# SYNC_DEVICE=                                # Device identifier in commit messages

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8318   # Backend API URL for the UI
# NEXT_PUBLIC_USER_ID=user                    # Default user ID
